# Copy to .env in this directory — Vite loads it automatically, no shell export needed.

# Base URL the frontend uses to reach the backend API. Includes the /api prefix —
# every service builds its request as `${VITE_API_BASE_URL}/<resource>`, so this is
# the one place that prefix lives, instead of being repeated in every service file.
VITE_API_BASE_URL=http://localhost:3000/api

# Port Vite's local dev server listens on.
FRONTEND_PORT=5173

# Backend origin the dev server proxies /resources/* requests to, so app-frontend assets are
# always fetched same-origin (matching production, where nginx proxies them too) — this is what
# lets the browser attach the cookie-based session to app resource requests. Optional, defaults
# to http://localhost:3000.
VITE_BACKEND_ORIGIN=http://localhost:3000
