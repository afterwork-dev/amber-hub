# Copy to .env — `npm run dev`/`npm run start` load it automatically via Node's
# --env-file-if-exists flag. No need to export these into your shell manually.

# Port the backend listens on.
PORT=3000

# MongoDB connection string. Required — the backend fails fast at startup if unset.
MONGODB_URI=mongodb://localhost:27017/amber-hub

# Secret used to sign login JWTs. Required — the backend fails fast at startup if unset.
JWT_SECRET=change-me-to-a-long-random-value

# How long an issued JWT stays valid (jsonwebtoken duration string, e.g. 15m, 1h). Optional, defaults to 15m.
JWT_EXPIRES_IN=15m

# How long a refresh token stays valid before the user must sign in again (jsonwebtoken duration string, e.g. 7d, 30d). Optional, defaults to 7d.
JWT_REFRESH_EXPIRES_IN=7d

# Origin the CORS policy allows to call this API. Optional, defaults to http://localhost:5173.
FRONTEND_ORIGIN=http://localhost:5173
